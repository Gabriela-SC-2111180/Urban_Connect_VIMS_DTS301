# VIMS backend configuration (copy to .env for local dev; never commit .env).
# The scaffold reads these via src/config/env.ts.

# Port the API listens on for local dev (plain HTTP locally; HTTPS/TLS is an
# NFR for deployment — see NFR-A / NFR-2, deliberately not implemented yet).
PORT=4000

# Node environment: development | test | production
NODE_ENV=development

# SQLite database file path (relative to the backend/ folder).
# DM-1 owns the real schema; this is just where the connection will point.
DB_PATH=./data/vims.sqlite

# Allowed CORS origin for the frontend dev server.
# The frontend scaffold (Vite default) typically runs on 5173.
# Confirm with the frontend Dylan and update if different.
CORS_ORIGIN=http://localhost:5173

# Logging format for morgan: dev | combined | tiny
LOG_FORMAT=dev
