# VIMS frontend configuration. Copy to .env.local for local dev (never commit .env*).
# Vite only exposes vars prefixed with VITE_ to client code.

# Base URL of the backend REST API.
# Backend dev default is port 4000 (see backend/.env.example PORT=4000).
# The typed API client (src/api/client.ts) reads this; if unset it falls back
# to the value baked into src/config/env.ts.
VITE_API_BASE_URL=http://localhost:4000
